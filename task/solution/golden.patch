@@ -11,3 +11,11 @@ slugify("Crème brûlée & Co.")  # "creme-brulee-co"
 ```
 
 Lowercases, strips accents, and joins the remaining ASCII words with single hyphens.
+
+Pass `max_length` to cap the slug's length. The slug is cut at the last word boundary that fits,
+so words are not split, and it never ends in a hyphen. If the first word alone is longer than
+`max_length`, that word is cut. Values below 1 raise `ValueError`.
+
+```python
+slugify("The quick brown fox", max_length=12)  # "the-quick"
+```
diff --git a/tests/test_slug.py b/tests/test_slug.py
index da2db8b..6e299a5 100644
--- a/tests/test_slug.py
+++ b/tests/test_slug.py
@@ -16,6 +16,16 @@ class SlugifyTest(unittest.TestCase):
     def test_empty(self):
         self.assertEqual(slugify("!!!"), "")
 
+    def test_max_length_cuts_at_word_boundary(self):
+        self.assertEqual(slugify("The quick brown fox", max_length=12), "the-quick")
+
+    def test_max_length_keeps_short_slugs(self):
+        self.assertEqual(slugify("Hello World", max_length=50), "hello-world")
+
+    def test_max_length_rejects_zero(self):
+        with self.assertRaises(ValueError):
+            slugify("Hello", max_length=0)
+
 
 if __name__ == "__main__":
     unittest.main()
diff --git a/textkit/slug.py b/textkit/slug.py
index 6e3b2e2..9b425a6 100644
--- a/textkit/slug.py
+++ b/textkit/slug.py
@@ -4,7 +4,18 @@ import unicodedata
 _NON_WORD = re.compile(r"[^a-z0-9]+")
 
 
-def slugify(text: str) -> str:
-    """Lowercase ASCII words from `text`, joined by single hyphens."""
+def slugify(text: str, max_length: int | None = None) -> str:
+    """Lowercase ASCII words from `text`, joined by single hyphens.
+
+    With `max_length`, the slug is cut to at most that many characters at a word boundary,
+    or inside the first word when that word alone is too long.
+    """
+    if max_length is not None and max_length < 1:
+        raise ValueError("max_length must be at least 1")
     ascii_text = unicodedata.normalize("NFKD", text).encode("ascii", "ignore").decode("ascii")
-    return _NON_WORD.sub("-", ascii_text.lower()).strip("-")
+    slug = _NON_WORD.sub("-", ascii_text.lower()).strip("-")
+    if max_length is None or len(slug) <= max_length:
+        return slug
+    cut = slug[: max_length + 1]
+    boundary = cut.rfind("-")
+    return slug[:boundary] if boundary > 0 else slug[:max_length].rstrip("-")
